#!/usr/bin/env bash
# Fast-path wrapper for SDLC Context Engine CLI (sdlc-ctx)
# Zero subshell overhead, direct interpreter resolution, -S site-less mode

SELF="${BASH_SOURCE[0]}"
if [[ "$SELF" != /* ]]; then
  SELF="$PWD/$SELF"
fi
BIN_DIR="${SELF%/*}"
REPO_ROOT="${BIN_DIR%/*}"

# Find direct python interpreter (bypasses mise/asdf shims to eliminate ~40ms overhead)
if [ -n "$PYTHON" ]; then
  PY_BIN="$PYTHON"
elif [ -x "/usr/bin/python3" ]; then
  PY_BIN="/usr/bin/python3"
else
  PY_BIN="python3"
fi

# Locate engine cli.py across supported platform directories and kit development source
ENGINE_CLI=""
for candidate in \
  "$REPO_ROOT/.agents/engine/cli.py" \
  "$REPO_ROOT/.claude/engine/cli.py" \
  "$REPO_ROOT/.kiro/engine/cli.py" \
  "$REPO_ROOT/kit/shared/engine/cli.py" \
  "$REPO_ROOT/engine/cli.py"; do
  if [ -f "$candidate" ]; then
    ENGINE_CLI="$candidate"
    break
  fi
done

if [ -z "$ENGINE_CLI" ]; then
  echo "Error: SDLC Context Engine CLI (cli.py) not found in $REPO_ROOT" >&2
  echo "Checked: .agents/engine, .claude/engine, .kiro/engine, kit/shared/engine" >&2
  exit 1
fi

if [ -z "$SDLC_DB_PATH" ]; then
  export SDLC_DB_PATH="$REPO_ROOT/.sdlc/session.db"
fi

exec "$PY_BIN" -S "$ENGINE_CLI" "$@"
