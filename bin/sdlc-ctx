#!/usr/bin/env bash
# Fast-path wrapper for SDLC Context Engine CLI (sdlc-ctx)
# Zero subshell overhead, direct interpreter resolution, -S site-less mode

SELF="${BASH_SOURCE[0]}"
if [[ "$SELF" != /* ]]; then
  SELF="$PWD/$SELF"
fi
BIN_DIR="${SELF%/*}"
REPO_ROOT="${BIN_DIR%/*}"

# Find direct python interpreter (bypasses mise/asdf shims to eliminate ~40ms overhead)
if [ -n "$PYTHON" ]; then
  PY_BIN="$PYTHON"
elif [ -x "/usr/bin/python3" ]; then
  PY_BIN="/usr/bin/python3"
else
  PY_BIN="python3"
fi

exec "$PY_BIN" -S "$REPO_ROOT/kit/shared/engine/cli.py" "$@"
