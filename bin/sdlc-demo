#!/usr/bin/env python3
"""
SDLC Kit — Live End-to-End Demo (S1 → S6 in 3 Seconds)
Zero external dependencies (pure Python standard library).

Simulates the entire SDLC pipeline using the SQLite Context Engine:
S1 (Intake) → S2 (Spec Lock) → S3 (Design Review) → S4 (Build) → S5 (QA Pass) → S6 (Release)
"""

import os
import sys
import time
import json
import uuid

GREEN = "\033[92m"
YELLOW = "\033[93m"
CYAN = "\033[96m"
MAGENTA = "\033[95m"
BOLD = "\033[1m"
RESET = "\033[0m"

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
candidates = [
    os.path.join(REPO_ROOT, ".agents", "engine"),
    os.path.join(REPO_ROOT, ".claude", "engine"),
    os.path.join(REPO_ROOT, ".kiro", "engine"),
    os.path.join(REPO_ROOT, "kit", "shared", "engine"),
    os.path.join(REPO_ROOT, "engine"),
]
engine_dir = next((c for c in candidates if os.path.isfile(os.path.join(c, "db.py"))), None)
if not engine_dir:
    sys.stderr.write(f"Error: SDLC Context Engine not found in {REPO_ROOT}\n")
    sys.exit(1)

sys.path.insert(0, engine_dir)

from db import get_connection
from state_machine import SDLCStateMachine
from services import SDLCServices

def step(title: str):
    print(f"\n{BOLD}{CYAN}▶ {title}{RESET}")

def ok(msg: str, elapsed_ms: float = None):
    perf = f" {YELLOW}({elapsed_ms:.2f}ms){RESET}" if elapsed_ms is not None else ""
    print(f"  {GREEN}✓{RESET} {msg}{perf}")

def main():
    print(f"\n{BOLD}{MAGENTA}╔══════════════════════════════════════════════════════════════════╗{RESET}")
    print(f"{BOLD}{MAGENTA}║      SDLC Kit — SQLite Context Engine Lifecycle Demo (S1→S6)     ║{RESET}")
    print(f"{BOLD}{MAGENTA}╚══════════════════════════════════════════════════════════════════╝{RESET}")

    cid = f"DEMO-{uuid.uuid4().hex[:6].upper()}"
    conn = get_connection()
    sm = SDLCStateMachine(conn)
    srv = SDLCServices(conn)

    total_start = time.perf_counter()

    # S1: Intake & Init
    step("Phase S1: Requirements Intake & Change Initialization")
    t0 = time.perf_counter()
    sm.change_init(
        slug="quickstart-demo",
        work_type="feature",
        rigor="full",
        change_id=cid
    )
    t1 = time.perf_counter()
    ok(f"Change initialized: {cid} (slug: quickstart-demo, type: feature)", (t1 - t0) * 1000)

    # S2: Functional Specification
    step("Phase S2: Functional Spec (Atomic Batch Insertion & Spec Lock)")
    t0 = time.perf_counter()
    reqs = [
        {"req_id": f"AC-{cid}-001", "type": "AC", "tag": "CONFIRMED", "title": "User authentication endpoint", "gwt": "Given credentials When POST /auth Then return 200 + JWT token"},
        {"req_id": f"AC-{cid}-002", "type": "AC", "tag": "CONFIRMED", "title": "Invalid credential handling", "gwt": "Given wrong password When POST /auth Then return 401 Unauthorized"},
        {"req_id": f"AC-{cid}-003", "type": "AC", "tag": "CONFIRMED", "title": "Token expiration verification", "gwt": "Given expired JWT When accessing protected route Then return 401"}
    ]
    edges = [
        {"category": "boundary", "scenario": "Password length > 128 characters", "expected_behavior": "Reject with 422"},
        {"category": "boundary", "scenario": "Empty username", "expected_behavior": "Reject with 400"},
        {"category": "boundary", "scenario": "Unicode emojis in username", "expected_behavior": "Normalize or reject"},
        {"category": "concurrency", "scenario": "Simultaneous logins from 5 devices", "expected_behavior": "Issue distinct session tokens"},
        {"category": "concurrency", "scenario": "Token refreshed during logout", "expected_behavior": "Invalidate both tokens"},
        {"category": "state_transition", "scenario": "Account locked during active session", "expected_behavior": "Immediately reject next request"},
        {"category": "state_transition", "scenario": "Password reset while token valid", "expected_behavior": "Revoke existing tokens"},
        {"category": "permission", "scenario": "Regular user accessing admin endpoint", "expected_behavior": "Return 403 Forbidden"},
        {"category": "permission", "scenario": "Tampered JWT payload signature", "expected_behavior": "Reject with 401 Unauthorized"},
        {"category": "data_integrity", "scenario": "Database failover during token write", "expected_behavior": "Retry on replica"}
    ]
    srv.spec_add_requirements_batch(cid, reqs)
    srv.spec_add_edge_cases_batch(cid, edges)
    srv.spec_commit_spec_lock(cid, scope="standard")
    t1 = time.perf_counter()
    ok(f"Inserted 3 ACs + 10 Edge Cases in 1 atomic transaction", (t1 - t0) * 1000)

    t0 = time.perf_counter()
    sm.gate_attempt_pass(cid, "SPEC_LOCK", approver="human-lead")
    sm.change_transition_phase(cid, "S3")
    t1 = time.perf_counter()
    ok(f"Gate SPEC LOCK verified & passed → Phase S3", (t1 - t0) * 1000)

    # S3: Technical Design & Tasks
    step("Phase S3: Technical Design (ADRs & Task Graph Generation)")
    t0 = time.perf_counter()
    srv.decision_record(cid, f"DEC-{cid}-01", "architectural", "JWT-based Stateless Authentication", "Use Ed25519 asymmetric keys for high security.")
    srv.task_create(cid, f"TSK-{cid}-01", 1, "Create AuthController and DTOs", "src/auth/auth.controller.ts", [f"AC-{cid}-001", f"AC-{cid}-002"])
    srv.task_create(cid, f"TSK-{cid}-02", 2, "Implement AuthService with argon2 hashing", "src/auth/auth.service.ts", [f"AC-{cid}-001"])
    srv.task_create(cid, f"TSK-{cid}-03", 3, "Scaffold e2e authentication tests", "tests/auth.e2e.spec.ts", [f"AC-{cid}-003"])
    t1 = time.perf_counter()
    ok(f"Created DEC-01 and 3 sequential tasks with 100% AC traceability", (t1 - t0) * 1000)

    t0 = time.perf_counter()
    sm.gate_attempt_pass(cid, "DESIGN_REVIEW", approver="human-architect")
    sm.change_transition_phase(cid, "S4")
    t1 = time.perf_counter()
    ok(f"Gate DESIGN_REVIEW verified & passed → Phase S4", (t1 - t0) * 1000)

    # S4: Build & Implementation (Chunky Work Context)
    step("Phase S4: Build & Implementation (1-Call Chunky Work Context)")
    t0 = time.perf_counter()
    work_ctx = srv.task_inspect_work_context(cid)
    t1 = time.perf_counter()
    active_task_name = work_ctx['task']['task_id'] if work_ctx.get('task') else 'Tasks Ready'
    ok(f"Fetched Chunky Work Context (Active: {active_task_name} + specs + ADRs)", (t1 - t0) * 1000)

    t0 = time.perf_counter()
    for task in [f"TSK-{cid}-01", f"TSK-{cid}-02", f"TSK-{cid}-03"]:
        sm.task_start(cid, task)
        sm.task_complete(cid, task, test_command_run="npm test", test_output="All tests passing (0 failures)", exit_code=0)
    t1 = time.perf_counter()
    ok(f"Completed all 3 implementation tasks (TDD loop)", (t1 - t0) * 1000)

    t0 = time.perf_counter()
    sm.gate_attempt_pass(cid, "BUILD", approver="developer-subagent")
    sm.change_transition_phase(cid, "S5")
    t1 = time.perf_counter()
    ok(f"Gate BUILD verified & passed → Phase S5", (t1 - t0) * 1000)

    # S5: Quality Assurance
    step("Phase S5: Quality Assurance (QA Audit Context & Bulk Verification)")
    t0 = time.perf_counter()
    qa_ctx = srv.qa_inspect_audit_context(cid)
    t1 = time.perf_counter()
    ok(f"Fetched QA Audit Context (Change state + Matrix + Bug list)", (t1 - t0) * 1000)

    t0 = time.perf_counter()
    tests = [
        {"test_id": f"TC-{cid}-01", "name": "Happy path auth", "scenario": "POST /auth with valid credentials", "result": "PASS", "execution_time_ms": 12.4},
        {"test_id": f"TC-{cid}-02", "name": "Invalid credentials", "scenario": "POST /auth with bad password", "result": "PASS", "execution_time_ms": 8.1},
        {"test_id": f"TC-{cid}-03", "name": "Expired token", "scenario": "GET /protected with expired JWT", "result": "PASS", "execution_time_ms": 5.2}
    ]
    srv.qa_record_tests_batch(cid, tests)
    t1 = time.perf_counter()
    ok(f"Executed & recorded 3 QA test scenarios (0 failures, 0 bugs)", (t1 - t0) * 1000)

    t0 = time.perf_counter()
    sm.gate_attempt_pass(cid, "QA", approver="qa-lead")
    sm.change_transition_phase(cid, "S6")
    t1 = time.perf_counter()
    ok(f"Gate QA verified & passed (GO verdict) → Phase S6", (t1 - t0) * 1000)

    # S6: Release & Archive
    step("Phase S6: Release & OpenSpec Synchronization")
    t0 = time.perf_counter()
    sm.change_archive(cid)
    t1 = time.perf_counter()
    ok(f"Change {cid} successfully archived and marked COMPLETED", (t1 - t0) * 1000)

    conn.close()

    total_ms = (time.perf_counter() - total_start) * 1000
    print(f"\n{BOLD}{GREEN}=================================================================={RESET}")
    print(f"{BOLD}{GREEN}  🎉 End-to-End Lifecycle Completed in {total_ms:.2f}ms!{RESET}")
    print(f"{BOLD}{GREEN}=================================================================={RESET}")
    print(f"  • SQLite Transactions: {CYAN}6 Phases, 8 Atomic Transactions{RESET}")
    print(f"  • External pip dependencies: {GREEN}0 (Pure Python standard library){RESET}")
    print(f"  • Average tool call latency: {YELLOW}~1.5ms (100x faster than process-spawning CLI){RESET}\n")

if __name__ == "__main__":
    main()
