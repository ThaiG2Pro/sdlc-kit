#!/usr/bin/env bash
# Fast launcher for SDLC Model Context Protocol Server (Zero fork overhead, JSON-RPC stdio)

SELF="${BASH_SOURCE[0]}"
if [[ "$SELF" != /* ]]; then
  SELF="$PWD/$SELF"
fi
BIN_DIR="${SELF%/*}"
REPO_ROOT="${BIN_DIR%/*}"

# Find direct python interpreter (bypasses mise/asdf shims)
if [ -n "$PYTHON" ]; then
  PY_BIN="$PYTHON"
elif [ -x "/usr/bin/python3" ]; then
  PY_BIN="/usr/bin/python3"
else
  PY_BIN="python3"
fi

exec "$PY_BIN" -S "$REPO_ROOT/kit/shared/engine/mcp_server.py" "$@"
